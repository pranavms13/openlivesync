{
  "name": "@openlivesync/client",
  "version": "1.1.1",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react-entry.d.ts",
      "import": "./dist/react-entry.js",
      "default": "./dist/react-entry.js"
    },
    "./yjs": {
      "types": "./dist/yjs-provider.d.ts",
      "import": "./dist/yjs-provider.js",
      "default": "./dist/yjs-provider.js"
    },
    "./yjs-react": {
      "types": "./dist/yjs-react.d.ts",
      "import": "./dist/yjs-react.js",
      "default": "./dist/yjs-react.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "yjs": "*",
    "y-protocols": "*",
    "lib0": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "yjs": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "lib0": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^28.1.0",
    "lib0": "^0.2.117",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pranavms13/openlivesync.git"
  }
}
